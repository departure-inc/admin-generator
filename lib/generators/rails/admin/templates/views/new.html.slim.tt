div class='mb-6 flex items-center justify-between'
  h1 class='text-2xl font-bold text-gray-900' <%= human_name %>新規作成
  = link_to '一覧へ', admin_<%= plural_name %>_path, class: 'inline-flex items-center px-4 py-2 bg-white text-gray-700 text-sm font-medium rounded-md border border-gray-300 hover:bg-gray-50 transition-colors'

div class='bg-white rounded-lg shadow p-6'
  = render 'form', <%= singular_name %>: @<%= singular_name %>
