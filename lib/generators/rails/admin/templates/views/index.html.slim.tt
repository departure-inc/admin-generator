div class='mb-6 flex items-center justify-between'
  h1 class='text-2xl font-bold text-gray-900' <%= human_name %>一覧
  = link_to '新規作成', new_admin_<%= singular_name %>_path, class: 'inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md shadow-sm hover:bg-indigo-700 transition-colors'

div class='bg-white rounded-lg shadow p-4 mb-6'
  = render 'search_form', q: @q

div class='bg-white rounded-lg shadow overflow-hidden'
  div class='px-6 py-3 border-b border-gray-200 flex items-center justify-between'
    p class='text-sm text-gray-500'
      = "<%= human_name %>: #{@<%= plural_name %>.total_count}件"
    = link_to 'CSVダウンロード', admin_<%= plural_name %>_path(q: params[:q]&.to_unsafe_h, format: :csv), class: 'inline-flex items-center px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-md shadow-sm hover:bg-green-700 transition-colors'
  div class='overflow-x-auto'
    table class='min-w-full divide-y divide-gray-200'
      thead class='bg-gray-50'
        tr
<% model_columns.each do |col| %>
          th class='px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider' <%= col.name %>
<% end %>
          th class='px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider' 操作
      tbody class='bg-white divide-y divide-gray-200'
        - @<%= plural_name %>.each do |<%= singular_name %>|
          tr class='hover:bg-gray-50 transition-colors'
<% model_columns.each do |col| %>
            td class='px-6 py-4 whitespace-nowrap text-sm text-gray-900' = <%= singular_name %>.<%= col.name %>
<% end %>
            td class='px-6 py-4 whitespace-nowrap text-right text-sm'
              div class='flex justify-end gap-2'
                = link_to '詳細', admin_<%= singular_name %>_path(<%= singular_name %>), class: 'inline-flex items-center px-3 py-1.5 rounded-md text-xs font-medium text-indigo-700 bg-indigo-50 hover:bg-indigo-100 transition-colors'
                = link_to '編集', edit_admin_<%= singular_name %>_path(<%= singular_name %>), class: 'inline-flex items-center px-3 py-1.5 rounded-md text-xs font-medium text-yellow-700 bg-yellow-50 hover:bg-yellow-100 transition-colors'
                = link_to '削除', admin_<%= singular_name %>_path(<%= singular_name %>), data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか？' }, class: 'inline-flex items-center px-3 py-1.5 rounded-md text-xs font-medium text-red-700 bg-red-50 hover:bg-red-100 transition-colors'

= render 'admin/shared/pagination', collection: @<%= plural_name %>
