= search_form_for q, url: admin_<%= plural_name %>_path, html: { method: :get } do |f|
  div class='flex flex-wrap gap-3 items-end'
<% if search_columns.any? -%>
    div
      = f.label :<%= freeword_attribute %>, 'キーワード検索', class: 'block text-xs font-medium text-gray-600 mb-1'
      = f.search_field :<%= freeword_attribute %>, placeholder: 'キーワードを入力', class: 'block border border-gray-300 rounded-md shadow-sm px-3 py-2 text-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 w-64'
<% end -%>
    div class='flex gap-2'
      = f.submit '検索', class: 'inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 transition-colors cursor-pointer'
      = link_to '条件クリア', admin_<%= plural_name %>_path, class: 'inline-flex items-center px-4 py-2 bg-white text-gray-700 text-sm font-medium rounded-md border border-gray-300 hover:bg-gray-50 transition-colors'
