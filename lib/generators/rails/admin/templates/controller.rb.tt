class Admin::<%= class_name.pluralize %>Controller < Admin::ApplicationController
  include CsvExportable

  before_action :set_<%= singular_name %>, only: [ :show, :edit, :update, :destroy ]

  def index
    @q = <%= class_name %>.ransack(params[:q])
    @<%= plural_name %> = @q.result.page(params[:page])
    respond_to do |format|
      format.html
      format.csv { export_csv(@q.result, filename: "<%= plural_name %>-#{Time.zone.today}.csv") }
    end
  end

  def show; end

  def new
    @<%= singular_name %> = <%= class_name %>.new
  end

  def edit; end

  def create
    @<%= singular_name %> = <%= class_name %>.new(<%= singular_name %>_params)
    if @<%= singular_name %>.save
      redirect_to admin_<%= singular_name %>_path(@<%= singular_name %>), notice: t('admin.notices.created', model: '<%= human_name %>')
    else
      render :new, status: :unprocessable_content
    end
  end

  def update
    if @<%= singular_name %>.update(<%= singular_name %>_params)
      redirect_to admin_<%= singular_name %>_path(@<%= singular_name %>), notice: t('admin.notices.updated', model: '<%= human_name %>')
    else
      render :edit, status: :unprocessable_content
    end
  end

  def destroy
    @<%= singular_name %>.destroy
    redirect_to admin_<%= plural_name %>_path, notice: t('admin.notices.deleted', model: '<%= human_name %>')
  end

  private

  def set_<%= singular_name %>
    @<%= singular_name %> = <%= class_name %>.find(params.expect(:id))
  end

  def <%= singular_name %>_params
    params.expect(<%= singular_name %>: [ <%= form_columns.map { |c| ":#{c.name}" }.join(', ') %> ])
  end
end
